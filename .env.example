# Environment Variables Example
# Copy this file to .env and fill in the actual values

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_employee_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI/Anthropic API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini AI and document embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDICAL_DATA_ENCRYPTION_KEY=

# Meta Cloud API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0
WOOCOMMERCE_CALLBACK_URL=https://YOUR_API_HOST/api/v1/woocommerce/oauth/callback

# Shopify backend connection: see docs/SHOPIFY_TESTING.md
SHOPIFY_TENANT_ID=
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_TEST_SKU=
# Keep this key private and stable; generate a random value with at least 32 characters.
INTEGRATION_ENCRYPTION_KEY=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://YOUR_API_HOST/api/v1/shopify/oauth/callback
SHOPIFY_SCOPES=read_inventory,write_inventory,read_orders,write_orders
WEB_APP_URL=https://YOUR_DASHBOARD_HOST

# Environment Variables Example
# Copy this file to .env and fill in the actual values

NODE_ENV=development
PORT=3001
# Required: supply your own PostgreSQL connection string; never commit populated values.
DATABASE_URL=
# Neon: runtime uses a pooled (-pooler) postgresql:// URL with sslmode=require.
# Migrations use either optional direct URL (without -pooler); never commit values.
# DIRECT_DATABASE_URL=
# DATABASE_URL_UNPOOLED=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional deployment-only URLs for hosted services; local development can stay local.
# DEPLOY_DATABASE_URL=
# DEPLOY_DIRECT_DATABASE_URL=
# DEPLOY_REDIS_URL=

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_employee_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Cloud-managed Redis URL takes precedence over host/port settings. Use rediss:// for TLS.
# Inject through your API provider environment settings (or secret store).
# REDIS_URL=rediss://default:URL_ENCODED_PASSWORD@REDIS_HOST:6380/0
# Upstash uses rediss://default:URL_ENCODED_PASSWORD@ENDPOINT.upstash.io:6379/0
# Vercel HTTP API requires false; BullMQ consumers/schedulers need a separate host.
# BACKGROUND_WORKERS_ENABLED=false
# Optional dedicated PostgreSQL test URL. npm test derives a local *_test DB otherwise.
TEST_DATABASE_URL=
TEST_REDIS_DB=15
# Explicit browser origins; comma-separated. Production requires public HTTPS origins.
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# OpenAI/Anthropic API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini AI and document embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDICAL_DATA_ENCRYPTION_KEY=

# Self-hosted free-only voice worker (no paid-provider API key).
VOICE_TRANSCRIBER_URL=
VOICE_WORKER_AUTH_KEY=
VOICE_TRANSCRIPTION_PROVIDER=
VOICE_PAYMENT_POLICY=

# Meta Cloud API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0
WOOCOMMERCE_CALLBACK_URL=https://YOUR_API_HOST/api/v1/woocommerce/oauth/callback

# Shopify backend connection: see docs/SHOPIFY_TESTING.md
SHOPIFY_TENANT_ID=
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_TEST_SKU=
# Generate a random secret of at least 32 characters; keep it stable across deployments and store it only in the API host's secret manager.
INTEGRATION_ENCRYPTION_KEY=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://YOUR_API_HOST/api/v1/shopify/oauth/callback
SHOPIFY_SCOPES=read_products,read_inventory,write_inventory,read_orders,write_orders
WEB_APP_URL=https://YOUR_DASHBOARD_HOST

# Google Calendar: backend OAuth credentials, separate from your Gemini API key.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Register this exact frontend URI on your Google OAuth Web application.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# Optional web server setting; use your private API origin when deploying.
API_INTERNAL_URL=http://localhost:3001
# Optional public API origin, never a secret. Vercel should use API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=
# Public HTTPS API origin used to generate Dograh webhook URLs (no path).
# Workspace Dograh API keys and webhook secrets are encrypted in the integration settings.
PUBLIC_API_URL=
DOGRAH_API_URL=https://app.dograh.com
DOGRAH_API_KEY=
DOGRAH_AGENT_ID=
DOGRAH_WEBHOOK_SECRET=

# Copy to .env.production. Never commit the populated file.
NODE_ENV=production
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
WEB_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
DATABASE_URL=postgresql://workforce:REPLACE_WITH_URL_SAFE_RANDOM_VALUE@postgres:5432/ai_workforce
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET
MEDICAL_DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_SECRET
LOG_LEVEL=info
META_VERIFY_TOKEN=REPLACE
META_APP_SECRET=REPLACE
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
GEMINI_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://app.example.com/api/calendar/google/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://api.example.com/api/v1/shopify/oauth/callback
SHOPIFY_SCOPES=read_products,read_inventory,write_inventory,read_orders,write_orders
# Enable test/live mode only after providing matching Stripe keys and real price IDs.
BILLING_MODE=disabled
BILLING_ENFORCEMENT=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON array, no invented prices. Create your approved monthly prices in Stripe.
BILLING_PLANS_JSON=[]
BACKUP_AGE_RECIPIENT=
BACKUP_S3_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

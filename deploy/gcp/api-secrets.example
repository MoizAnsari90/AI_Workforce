# ENVIRONMENT_VARIABLE=SECRET_MANAGER_NAME:NUMERIC_VERSION
# Create these secrets first. Pin versions; never paste the values here.
DATABASE_URL=ai-workforce-database-url:1
REDIS_URL=ai-workforce-redis-url:1
GEMINI_API_KEY=ai-workforce-gemini-key:1
JWT_SECRET=ai-workforce-jwt-secret:1
INTEGRATION_ENCRYPTION_KEY=ai-workforce-integration-key:1
MEDICAL_DATA_ENCRYPTION_KEY=ai-workforce-medical-key:1
META_APP_SECRET=ai-workforce-meta-app-secret:1
META_VERIFY_TOKEN=ai-workforce-meta-verify-token:1
# Optional direct, non-transaction-pooled migration connection:
# DIRECT_DATABASE_URL=ai-workforce-direct-database-url:1
# Optional connector/billing secrets, when those features are enabled:
# META_ACCESS_TOKEN=ai-workforce-meta-access-token:1
# GOOGLE_CALENDAR_CLIENT_SECRET=ai-workforce-google-client-secret:1
# SHOPIFY_CLIENT_SECRET=ai-workforce-shopify-client-secret:1
# STRIPE_SECRET_KEY=ai-workforce-stripe-secret:1
# STRIPE_WEBHOOK_SECRET=ai-workforce-stripe-webhook:1

# Set these in your API hosting provider's environment settings, never in Git.
# Neon runtime format (replace every placeholder privately):
# postgresql://USER:URL_ENCODED_PASSWORD@ep-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connection_limit=3&pool_timeout=20
NODE_ENV=production
DATABASE_URL=
# Optional: direct, non-pooled migration connection; unset when unused.
# DIRECT_DATABASE_URL=
# Neon/Vercel unpooled alias is also accepted by scripts/run-migrations.cjs.
# DATABASE_URL_UNPOOLED=
# Direct format: postgresql://USER:URL_ENCODED_PASSWORD@ep-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
# Upstash TCP/TLS format; the HTTPS REST endpoint/token cannot be used by BullMQ:
# rediss://default:URL_ENCODED_PASSWORD@ENDPOINT.upstash.io:6379/0
REDIS_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
JWT_SECRET=
INTEGRATION_ENCRYPTION_KEY=
MEDICAL_DATA_ENCRYPTION_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
WEB_APP_URL=
PUBLIC_API_URL=
# Exact HTTPS origins separated by commas. Never use wildcard preview domains.
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
# Vercel Functions: false. Continuous hosts: true only when hosting consumers.
BACKGROUND_WORKERS_ENABLED=false
# Optional signed QStash callback worker; bounded five-minute batches.
SERVERLESS_AUTOMATION_ENABLED=false
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_TOKEN is needed privately by the schedule provisioning tool.
BILLING_MODE=disabled
BILLING_ENFORCEMENT=false
# GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/calendar/google/callback
# SHOPIFY_REDIRECT_URI=https://YOUR_API_DOMAIN/api/v1/shopify/oauth/callback

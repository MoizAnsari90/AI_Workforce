# Set these in Render's Environment dashboard, not in committed files.
NODE_ENV=production
DATABASE_URL=
# Optional: direct, non-pooled migration connection; unset when unused.
# DIRECT_DATABASE_URL=
REDIS_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
JWT_SECRET=
INTEGRATION_ENCRYPTION_KEY=
MEDICAL_DATA_ENCRYPTION_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
WEB_APP_URL=
PUBLIC_API_URL=
# Exact HTTPS origins separated by commas. Never use wildcard preview domains.
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
BACKGROUND_WORKERS_ENABLED=true
BILLING_MODE=disabled
BILLING_ENFORCEMENT=false
# GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/calendar/google/callback
# SHOPIFY_REDIRECT_URI=https://YOUR_RENDER_DOMAIN/api/v1/shopify/oauth/callback

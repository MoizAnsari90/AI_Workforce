datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Phase 10 — Commercial SaaS Readiness
// ---------------------------------------------------------------------------

model SubscriptionTier {
  id                   String   @id @default(uuid())
  name                 String   @unique
  maxAgents            Int      @map("max_agents")
  maxToolCallsPerMonth Int      @map("max_tool_calls_per_month")
  createdAt            DateTime @default(now()) @map("created_at")

  tenants              Tenant[] @relation("TenantSubscriptionTier")
  tenantCredits        TenantCredits[]

  @@map("subscription_tiers")
}

model TenantCredits {
  tenantId         String   @id @map("tenant_id")
  tierId           String   @map("tier_id")
  availableCredits Int      @default(0) @map("available_credits")
  lastRefillAt     DateTime @default(now()) @map("last_refill_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier             SubscriptionTier @relation(fields: [tierId], references: [id])

  @@map("tenant_credits")
}

model CreditConsumptionLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  amount      Int
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("credit_consumption_logs")
}

model IntegrationConfig {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  provider    String   // e.g., 'whatsapp', 'shopify', 'slack'
  config      Json     // OAuth2 tokens, API keys
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhooks    ConnectorWebhook[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("integration_configs")
}

model ConnectorWebhook {
  id             String   @id @default(uuid())
  integrationId  String   @map("integration_id")
  eventType      String   @map("event_type")
  payload        Json
  processedAt    DateTime @default(now()) @map("processed_at")

  integration    IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@map("connector_webhooks")
}

// ---------------------------------------------------------------------------
// Existing models...
// ---------------------------------------------------------------------------
model Tenant {
  id                       String   @id @default(uuid())
  name                     String
  stripeCustomerId         String?  @unique @map("stripe_customer_id")
  stripeSubscriptionStatus String   @default("inactive") @map("stripe_subscription_status")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  subscriptionTierId       String?  @map("subscription_tier_id")
  subscriptionTier         SubscriptionTier? @relation("TenantSubscriptionTier", fields: [subscriptionTierId], references: [id])
  tenantCredits            TenantCredits?
  creditLogs               CreditConsumptionLog[]
  integrations             IntegrationConfig[]

  users            User[]
  roles            Role[]
  businesses       Business[]
  agents           Agent[]
  tasks            Task[]
  workflows        Workflow[]
  approvalRequests ApprovalRequest[]
  auditLogs        AuditLog[]
  conversations    Conversation[]
  knowledgeSources KnowledgeSource[]
  documentChunks   DocumentChunk[]
  faqs             FAQ[]
  messages         Message[]
  events           SystemEvent[]
  leads            Lead[]
  salesActivities  SalesActivity[]
  salesPolicies    SalesPolicy[]
  salesMemories    SalesMemory[]
  marketingProfiles MarketingProfile[]
  campaigns        Campaign[]
  contentDrafts    ContentDraft[]
  campaignMetrics  CampaignMetric[]
  locations        WarehouseLocation[]
  suppliers        Supplier[]
  products         Product[]
  inventoryRecords InventoryRecord[]
  inventoryMovements InventoryMovement[]
  orders           PurchaseOrder[]
  orderItems       PurchaseOrderItem[]
  reorderRecommendations ReorderRecommendation[]
  stockAlerts      StockAlert[]
  demandSignals    DemandSignal[]
  operationsPolicies OperationsPolicy[]
  financialRecords FinancialRecord[]
  invoices        Invoice[]
  payments        PaymentRecord[]
  financeReports  FinanceReport[]
  financePolicies FinancePolicy[]
  workflowExecutions WorkflowExecution[]
  workflowEvents WorkflowEvent[]
  toolInvocations ToolInvocation[]
  harnessPolicies HarnessPolicy[]
  harnessRuns HarnessRun[]
  evaluationDatasets EvaluationDataset[]
  autonomousJobs AutonomousJob[]
  autonomousRuns AutonomousJobRun[]
  autonomousEvents AutonomousEvent[]
  autonomyNotifications AutonomyNotification[]
  autonomyHeartbeats AutonomyHeartbeat[]
  autonomyPolicies AutonomyPolicy[]
  tools            Tool[]
  voiceSessions    VoiceSession[]
  externalCredentials ExternalIntegrationCredential[]
  appointmentSlots AppointmentSlot[]
  patientIntakeRecords PatientIntakeRecord[]
  idempotencyLogs IdempotencyLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  approvalReviews ApprovalRequest[] @relation("UserApprovalReviews")

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  toolPermissions ToolPermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Business {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  name                 String
  industry             String?
  brandVoiceGuide      String?  @map("brand_voice_guide")
  supportPhoneNumberId String?  @map("support_phone_number_id")
  supportAccessToken   String?  @map("support_access_token")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("businesses")
}

model Agent {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  department       String
  name             String
  isActive         Boolean  @default(true) @map("is_active")
  currentVersionId String?  @map("current_version_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions         AgentVersion[]
  tasks            Task[]
  approvalRequests ApprovalRequest[]
  workflowNodes    WorkflowNode[]
  harnessRuns      HarnessRun[]

  @@index([tenantId])
  @@map("agents")
}

model AgentVersion {
  id            String   @id @default(uuid())
  agentId       String   @map("agent_id")
  systemPrompt  String   @map("system_prompt")
  temperature   Float    @default(0.0)
  toolAllowlist String[] @default([]) @map("tool_allowlist")
  createdAt     DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_versions")
}

model Tool {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  name            String
  description     String
  parameterSchema Json     @map("parameter_schema")
  isRisky         Boolean  @default(false) @map("is_risky")
  riskLevel       String   @default("low") @map("risk_level")
  requiresApproval Boolean @default(false) @map("requires_approval")
  verificationSchema Json? @map("verification_schema")
  timeoutMs       Int      @default(30000) @map("timeout_ms")
  maxRetries      Int      @default(0) @map("max_retries")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions ToolPermission[]
  invocations ToolInvocation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tools")
}

model ToolPermission {
  toolId       String @map("tool_id")
  permissionId String @map("permission_id")

  tool       Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([toolId, permissionId])
  @@map("tool_permissions")
}

model ToolInvocation {
  idempotencyKey    String   @id @map("idempotency_key")
  id                String   @unique @default(uuid())
  tenantId          String   @map("tenant_id")
  toolId            String   @map("tool_id")
  actorType         String   @map("actor_type")
  actorId           String   @map("actor_id")
  status            String   @default("awaiting_verification")
  inputPayload      Json     @map("input_payload")
  outputPayload     Json?    @map("output_payload")
  verificationStatus String  @default("pending") @map("verification_status")
  errorMessage     String?   @map("error_message")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Restrict)
  approvalRequests ApprovalRequest[]

  @@index([tenantId])
  @@index([toolId])
  @@index([status])
  @@map("tool_invocations")
}

model HarnessPolicy {
  id                      String   @id @default(uuid())
  tenantId                String   @map("tenant_id")
  maxInvocationsPerWindow Int      @default(100) @map("max_invocations_per_window")
  rateWindowSeconds       Int      @default(60) @map("rate_window_seconds")
  maxAgentRunIterations   Int      @default(25) @map("max_agent_run_iterations")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("harness_policies")
}

model HarnessRun {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  agentId             String?  @map("agent_id")
  workflowExecutionId String?  @map("workflow_execution_id")
  status              String   @default("running")
  iterationCount      Int      @default(0) @map("iteration_count")
  context             Json     @default("{}")
  startedAt           DateTime @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workflowExecution WorkflowExecution? @relation(fields: [workflowExecutionId], references: [id], onDelete: SetNull)
  iterations HarnessIteration[]

  @@index([tenantId])
  @@index([status])
  @@map("harness_runs")
}

model HarnessIteration {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  iteration Int
  action    String
  result    Json?
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  run HarnessRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, iteration])
  @@map("harness_iterations")
}

model EvaluationDataset {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cases EvaluationCase[]

  @@index([tenantId])
  @@map("evaluation_datasets")
}

model EvaluationCase {
  id        String   @id @default(uuid())
  datasetId String   @map("dataset_id")
  input     Json
  expected  Json
  createdAt DateTime @default(now()) @map("created_at")

  dataset EvaluationDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("evaluation_cases")
}

model AutonomousJob {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  name            String
  jobType         String   @map("job_type")
  triggerType     String   @default("schedule") @map("trigger_type")
  eventType       String?  @map("event_type")
  workflowId      String?  @map("workflow_id")
  intervalSeconds Int?     @map("interval_seconds")
  nextRunAt       DateTime? @map("next_run_at")
  enabled         Boolean  @default(true)
  maxRetries      Int      @default(3) @map("max_retries")
  lastRunAt       DateTime? @map("last_run_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  runs AutonomousJobRun[]

  @@unique([tenantId, name])
  @@index([tenantId, enabled, nextRunAt])
  @@index([tenantId, eventType])
  @@map("autonomous_jobs")
}

model AutonomousJobRun {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  jobId           String   @map("job_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  status          String   @default("running")
  attempt         Int      @default(1)
  inputPayload    Json     @default("{}") @map("input_payload")
  outputPayload   Json?    @map("output_payload")
  errorMessage    String?  @map("error_message")
  startedAt       DateTime @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job AutonomousJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([jobId, status])
  @@map("autonomous_job_runs")
}

model AutonomousEvent {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  eventKey    String   @map("event_key")
  eventType   String   @map("event_type")
  payload     Json     @default("{}")
  processedAt DateTime @default(now()) @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventKey])
  @@index([tenantId, eventType])
  @@map("autonomous_events")
}

model AutonomyNotification {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  notificationType String @map("notification_type")
  severity   String   @default("info")
  title      String
  body       String
  status     String   @default("unread")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  readAt     DateTime? @map("read_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("autonomy_notifications")
}

model AutonomyHeartbeat {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  component  String
  status     String   @default("healthy")
  metadata   Json     @default("{}")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, component])
  @@index([tenantId])
  @@map("autonomy_heartbeats")
}

model AutonomyPolicy {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  maxRunsPerWindow   Int      @default(100) @map("max_runs_per_window")
  runWindowSeconds   Int      @default(3600) @map("run_window_seconds")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("autonomy_policies")
}

model Task {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  agentId      String?   @map("agent_id")
  workflowId   String?   @map("workflow_id")
  leadId       String?   @map("lead_id")
  campaignId   String?   @map("campaign_id")
  workflowExecutionId String? @map("workflow_execution_id")
  title        String
  description  String?
  status       String    @default("pending")
  inputData    Json?     @map("input_data")
  outputData   Json?     @map("output_data")
  errorMessage String?   @map("error_message")
  scheduledAt  DateTime? @map("scheduled_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent            Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workflow         Workflow?         @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  lead             Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  workflowExecution WorkflowExecution? @relation(fields: [workflowExecutionId], references: [id], onDelete: SetNull)
  approvalRequests ApprovalRequest[]

  @@index([tenantId])
  @@index([agentId])
  @@index([leadId])
  @@index([campaignId])
  @@index([workflowExecutionId])
  @@index([status])
  @@map("tasks")
}

model Workflow {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  status     String   @default("running")
  graphState Json     @default("{}") @map("graph_state")
  graphDefinition Json  @default("{}") @map("graph_definition")
  maxRetries Int       @default(3) @map("max_retries")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks  Task[]
  nodes  WorkflowNode[]
  edges  WorkflowEdge[]
  executions WorkflowExecution[]
  autonomousJobs AutonomousJob[]

  @@index([tenantId])
  @@map("workflows")
}

model WorkflowNode {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  nodeKey    String   @map("node_key")
  nodeType   String   @map("node_type")
  agentId    String?  @map("agent_id")
  config     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agent    Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  outgoing WorkflowEdge[] @relation("WorkflowEdgeFrom")
  incoming WorkflowEdge[] @relation("WorkflowEdgeTo")
  executions WorkflowNodeExecution[]
  currentForExecutions WorkflowExecution[]

  @@unique([workflowId, nodeKey])
  @@index([workflowId])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  fromNodeId String   @map("from_node_id")
  toNodeId   String   @map("to_node_id")
  condition  Json?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromNode WorkflowNode @relation("WorkflowEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   WorkflowNode @relation("WorkflowEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([workflowId, fromNodeId, toNodeId])
  @@index([workflowId])
  @@map("workflow_edges")
}

model WorkflowExecution {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  workflowId     String   @map("workflow_id")
  status         String   @default("running")
  currentNodeId  String?  @map("current_node_id")
  context        Json     @default("{}")
  retryCount     Int      @default(0) @map("retry_count")
  idempotencyKey String   @map("idempotency_key")
  startedAt      DateTime @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  currentNode WorkflowNode? @relation(fields: [currentNodeId], references: [id], onDelete: SetNull)
  tasks Task[]
  nodeExecutions WorkflowNodeExecution[]
  events WorkflowEvent[]
  approvalRequests ApprovalRequest[]
  harnessRuns HarnessRun[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([workflowId])
  @@map("workflow_executions")
}

model WorkflowNodeExecution {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  nodeId      String   @map("node_id")
  attempt     Int      @default(1)
  status      String   @default("running")
  inputContext Json    @default("{}") @map("input_context")
  outputContext Json?  @map("output_context")
  errorMessage String? @map("error_message")
  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node WorkflowNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([executionId, nodeId, attempt])
  @@index([executionId])
  @@map("workflow_node_executions")
}

model WorkflowEvent {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  executionId   String   @map("execution_id")
  eventKey      String   @map("event_key")
  eventType     String   @map("event_type")
  payload       Json     @default("{}")
  processedAt   DateTime @default(now()) @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventKey])
  @@index([executionId])
  @@map("workflow_events")
}

model ApprovalRequest {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  requestedByAgentId String   @map("requested_by_agent_id")
  associatedTaskId   String?  @map("associated_task_id")
  workflowExecutionId String? @map("workflow_execution_id")
  toolInvocationId String? @map("tool_invocation_id")
  actionType         String   @map("action_type")
  actionPayload      Json     @map("action_payload")
  status             String   @default("pending")
  reviewedByUserId   String?  @map("reviewed_by_user_id")
  rejectionReason    String?  @map("rejection_reason")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent    Agent   @relation(fields: [requestedByAgentId], references: [id], onDelete: Cascade)
  task     Task?   @relation(fields: [associatedTaskId], references: [id], onDelete: SetNull)

// ---------------------------------------------------------------------------
// Phase 03 — Sales AI Employee
// ---------------------------------------------------------------------------

/// Lead lifecycle stages: new → contacted → qualified → proposal → won | lost | disqualified
model Lead {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  firstName     String    @map("first_name")
  lastName      String?   @map("last_name")
  email         String?
  phone         String?
  company       String?
  jobTitle      String?   @map("job_title")
  source        String?                          // whatsapp | web | manual | import
  status        String    @default("new")        // new | contacted | qualified | proposal | won | lost | disqualified
  score         Int       @default(0)            // 0–100 computed qualification score
  estimatedValue Decimal? @map("estimated_value") @db.Decimal(15, 2)
  currency      String    @default("USD")
  notes         String?
  assignedUserId String?  @map("assigned_user_id")
  campaignId     String?  @map("campaign_id")
  attributionSource String? @map("attribution_source")
  qualificationData Json? @map("qualification_data") // Configurable criteria answers
  lastContactedAt DateTime? @map("last_contacted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities SalesActivity[]
  tasks      Task[]
  memories   SalesMemory[]
  campaign   Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([campaignId])
  @@map("leads")
}

model SalesMemory {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  leadId     String?  @map("lead_id")
  memoryType String   @map("memory_type")
  content    String
  metadata   Json?
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId])
  @@map("sales_memories")
}

/// Immutable CRM activity log — one row per interaction or state change
model SalesActivity {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  leadId       String   @map("lead_id")
  activityType String   @map("activity_type") // note | call | email | whatsapp | status_change | score_update | approval_requested | proposal_sent
  summary      String
  payload      Json?                           // Structured extra data (e.g. old/new status, discount %)
  performedBy  String   @map("performed_by")  // userId or "sales-agent"
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId])
  @@map("sales_activities")
}

/// Per-tenant configurable sales guardrails
model SalesPolicy {
  id                     String   @id @default(uuid())
  tenantId               String   @map("tenant_id")
  maxDiscountPct         Decimal  @default(10) @map("max_discount_pct") @db.Decimal(5, 2)  // max discount % before approval required
  highValueDealThreshold Decimal  @default(10000) @map("high_value_deal_threshold") @db.Decimal(15, 2)
  requireApprovalAbove   Decimal  @default(10000) @map("require_approval_above") @db.Decimal(15, 2)
  qualificationCriteria  Json     @default("[]") @map("qualification_criteria") // Array of {key, label, weight}
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("sales_policies")
}

model MarketingProfile {
